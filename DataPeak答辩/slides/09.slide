<Slide style={{ width:'1280px', height:'720px', fontFamily:'Microsoft YaHei', background:'#FFFFFF', padding:'44px 48px', display:'flex', flexDirection:'column' }}>
  <Text style={{ fontSize:34, color:'#0B2A5B', fontWeight:'bold' }}>这些结论，来自真实生意数据</Text>
  <Box style={{ width:'100%', height:'2px', background:'#D6DCE5', marginTop:14, marginBottom:24 }} />
  <Box style={{ display:'flex', flexDirection:'row', gap:22, justifyContent:'space-between' }}>
    {[['10万+','真实订单（Olist 公开数据集）','#0E4DA4'],['2016–2018','约两年销售时间跨度','#00A878'],['9 张','原始 CSV 自举导入','#0E4DA4']].map((it,i)=>(
      <Box key={i} style={{ flex:1, background:'#F2F7FF', borderRadius:14, border:'1px solid #E1EAF6', padding:'26px 18px', display:'flex', flexDirection:'column', alignItems:'center' }}>
        <Text style={{ fontSize:62, color:it[2], fontWeight:'bold' }}>{it[0]}</Text>
        <Text style={{ fontSize:18, color:'#4A5568', marginTop:12, textAlign:'center', lineHeight:1.5 }}>{it[1]}</Text>
      </Box>
    ))}
  </Box>
  <Box style={{ flex:1, display:'flex', flexDirection:'row', gap:20, marginTop:22 }}>
    <Box style={{ flex:1, background:'#0B2A5B', borderRadius:12, padding:'22px 24px', display:'flex', flexDirection:'column', justifyContent:'center' }}>
      <Text style={{ fontSize:21, color:'#8BE0CC', fontWeight:'bold' }}>结论：用真实业务数据验证，而非造数演示</Text>
      <Text style={{ fontSize:17, color:'#C7E6FF', marginTop:10, lineHeight:1.7 }}>诊断、信号、预警全部来自约 10 万笔真实订单的端到端计算，演示可复现、可审计。</Text>
    </Box>
    <Box style={{ width:'40%', background:'#EAF7F1', borderRadius:12, padding:'22px 24px', display:'flex', flexDirection:'column', justifyContent:'center', border:'1px solid #BFE9D6' }}>
      <Text style={{ fontSize:18, color:'#0B2A5B', fontWeight:'bold', lineHeight:1.5 }}>诚实口径 = 答辩加分项</Text>
      <Text style={{ fontSize:16, color:'#3A6B52', marginTop:8, lineHeight:1.6 }}>补货建议明确标注"推测口径，非实时库存"。</Text>
    </Box>
  </Box>
</Slide>
